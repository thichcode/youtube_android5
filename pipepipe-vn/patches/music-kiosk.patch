+package org.schabi.newpipe.extractor.services.youtube.extractors;
+
+import org.schabi.newpipe.extractor.InfoItem;
+import org.schabi.newpipe.extractor.ListExtractor.InfoItemsPage;
+import org.schabi.newpipe.extractor.Page;
+import org.schabi.newpipe.extractor.StreamingService;
+import org.schabi.newpipe.extractor.downloader.Downloader;
+import org.schabi.newpipe.extractor.exceptions.ExtractionException;
+import org.schabi.newpipe.extractor.exceptions.ParsingException;
+import org.schabi.newpipe.extractor.kiosk.KioskExtractor;
+import org.schabi.newpipe.extractor.linkhandler.ListLinkHandler;
+import org.schabi.newpipe.extractor.stream.StreamInfoItem;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.annotation.Nonnull;
+
+public class YoutubeMusicKioskExtractor extends KioskExtractor<StreamInfoItem> {
+    private final YoutubeChannelTabExtractor delegate;
+
+    public YoutubeMusicKioskExtractor(final StreamingService service,
+                                      final ListLinkHandler linkHandler,
+                                      final String kioskId) {
+        super(service, linkHandler, kioskId);
+        delegate = new YoutubeChannelTabExtractor(service, linkHandler);
+    }
+
+    @Override
+    public void onFetchPage(@Nonnull final Downloader downloader)
+            throws IOException, ExtractionException {
+        delegate.fetchPage();
+    }
+
+    @Nonnull
+    @Override
+    public String getName() throws ParsingException {
+        return delegate.getName();
+    }
+
+    @Nonnull
+    @Override
+    public InfoItemsPage<StreamInfoItem> getInitialPage()
+            throws IOException, ExtractionException {
+        return toStreamPage(delegate.getInitialPage());
+    }
+
+    @Override
+    public InfoItemsPage<StreamInfoItem> getPage(final Page page)
+            throws IOException, ExtractionException {
+        return toStreamPage(delegate.getPage(page));
+    }
+
+    private static InfoItemsPage<StreamInfoItem> toStreamPage(
+            final InfoItemsPage<InfoItem> page) {
+        final List<StreamInfoItem> items = new ArrayList<>();
+        for (final InfoItem item : page.getItems()) {
+            if (item instanceof StreamInfoItem) {
+                items.add((StreamInfoItem) item);
+            }
+        }
+        return new InfoItemsPage<>(items, page.getNextPage(), page.getErrors());
+    }
+}
