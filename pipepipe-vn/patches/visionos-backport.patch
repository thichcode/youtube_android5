+                        }
+                    }
+                } catch (Exception e) {
+                    e.printStackTrace();
+                    errors.add(e);
+                }
+            }
+        };
+
+        return getJsonVisionOsPostResponseAsync(PLAYER,
+                mobileBody, localization, userAgent, "&t=" + generateTParameter()
+                        + "&id=" + videoId, callback);
+    }
